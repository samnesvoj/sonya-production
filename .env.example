# SONYA Production Environment — replace all CHANGE_ME values before deploy
# Copy to .env (never commit .env)

# App environment
APP_ENV=production

# Database (PostgreSQL only — no SQLite)
DATABASE_URL=CHANGE_ME

# S3 Storage (Timeweb Cloud S3 or any S3-compatible)
S3_BUCKET_NAME=CHANGE_ME
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_ENDPOINT_URL=https://s3.timeweb.cloud
S3_REGION=ru-1

# Models bucket (can be same as S3_BUCKET_NAME)
MODELS_S3_BUCKET=CHANGE_ME

# Worker auth secret (use: openssl rand -hex 32)
WORKER_SECRET=CHANGE_ME

# AI APIs
GEMINI_API_KEY=CHANGE_ME
OPENAI_API_KEY=CHANGE_ME
ELEVENLABS_API_KEY=CHANGE_ME

# CORS — comma-separated list, no wildcards in production
# NOTE: sonya-e.com does not match the domain used everywhere else in this
# repo (legal/*.html, docs/SONYA_AUDIT.md all say sonya.group) — confirm
# which is actually correct before deploying Robokassa (the ResultURL
# domain and this must agree, or the browser-facing part of the flow will
# get CORS errors even though the webhook itself doesn't go through CORS).
CORS_ORIGINS=https://sonya-e.com,https://www.sonya-e.com

# Robokassa — production credentials. Never commit real values here; fill
# only in the server's own .env (see deploy notes for the generate/update
# order that avoids a password mismatch between the Robokassa cabinet and
# this server).
ROBOKASSA_MERCHANT_LOGIN=sonyagroup
ROBOKASSA_PASSWORD_1=CHANGE_ME
ROBOKASSA_PASSWORD_2=CHANGE_ME

# Robokassa — test mode. When true: checkout uses ROBOKASSA_TEST_PASSWORD_1
# and adds IsTest=1; the ResultURL webhook for those payments is verified
# with ROBOKASSA_TEST_PASSWORD_2. Test and production passwords are never
# mixed — which pair applies is decided per-payment (see payments.is_test),
# not by whatever this flag currently says.
ROBOKASSA_TEST_MODE=true
ROBOKASSA_TEST_PASSWORD_1=CHANGE_ME
ROBOKASSA_TEST_PASSWORD_2=CHANGE_ME

# Robokassa — fiscal receipt (54-FZ). Leave disabled until the shop's
# actual fiscalization scheme (self-employed/NPD vs standard online kassa)
# is confirmed with Robokassa — do not guess sno/tax, they are legally
# significant.
ROBOKASSA_RECEIPT_ENABLED=false
ROBOKASSA_RECEIPT_SNO=CHANGE_ME
ROBOKASSA_RECEIPT_TAX=CHANGE_ME
ROBOKASSA_RECEIPT_PAYMENT_METHOD=CHANGE_ME
ROBOKASSA_RECEIPT_PAYMENT_OBJECT=CHANGE_ME

# Feature flags (safe defaults — enable per environment as needed)
SONYA_ENHANCERS_ENABLED=true
YOLO_COMMON_ENABLED=true
YOLO_POSE_ENABLED=true
WEBCAM_DETECTOR_ENABLED=true
GEMINI_DIRECT_VIDEO_ENABLED=false
GEMINI_LAYOUT_ENABLED=true
GEMINI_COMPOSER_ENABLED=true
SMART_CROP_ENABLED=true
WORD_LEVEL_SUBTITLES_ENABLED=true
LIP_SYNC_DETECTION_ENABLED=false
OPENAI_WHISPER_FALLBACK_ENABLED=false

# Upload limits (also caps a URL-download's resulting file size)
MAX_UPLOAD_SIZE_MB=2048

# URL video ingestion (YouTube / VK / Twitch / direct video links via yt-dlp)
URL_DOWNLOAD_MAX_DURATION_SEC=3600
URL_DOWNLOAD_TIMEOUT_SEC=600

# Streamer-mode-only overrides of the two limits above — every other mode
# keeps MAX_UPLOAD_SIZE_MB / URL_DOWNLOAD_MAX_DURATION_SEC unchanged.
# Streamer VODs commonly run 4-7h; defaults below (7h / 20GB) are a safe
# starting point, tune for your GPU disk/bandwidth budget.
STREAMER_URL_MAX_DURATION_SEC=25200
STREAMER_MAX_UPLOAD_SIZE_MB=20480

# Worker polling
WORKER_POLL_INTERVAL=10
WORKER_STALE_REQUEUE_INTERVAL=300

# Quota
QUOTA_ENABLED=true
QUOTA_MAX_CONCURRENT_JOBS=3
QUOTA_MAX_JOBS_PER_DAY=50

# Rate limiting
RATE_LIMIT_ENABLED=true

# Security audit
SECURITY_AUDIT_ENABLED=true

# Docs (disable in production)
ENABLE_DOCS=false
